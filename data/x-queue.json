    "requiresVerifiedFact": false,
    "verifiedFactIds": [],
    "approved": true,
    "approvedBy": "KEITA",
    "approvedAt": "2026-10-17T08:02:51.098Z"
  },
  {
    "id": "x-2026-10-25-noon",
    "date": "2026-10-25",
    "slot": "noon",
    "pillar": "ENVIRONMENT",
    "text": "海沿いのゴルフ場では、ボールが海へ入ることも。海外では、沿岸のゴルフ場近くの海から約5万球が回収されたという研究報告もあります。",
    "threadsItemId": "lb-2026-10-25-noon-ja",
