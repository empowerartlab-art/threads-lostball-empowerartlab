  {
    "id": "x-2026-10-21-noon",
    "date": "2026-10-21",
    "slot": "noon",
    "pillar": "GOLF",
    "text": "練習ラウンドくらいは、OBも池も気にせず振り抜きたい。新しいクラブを試す日、スイングを確かめる日。ボールの心配が少ないだけで、思い切って振れる。",
    "threadsItemId": "lb-2026-10-21-noon-ja",
    "requiresVerifiedFact": false,
    "verifiedFactIds": [],
    "approved": true,
    "approvedBy": "KEITA",
    "approvedAt": "2026-10-17T08:02:51.098Z"
  },
  {
    "id": "x-2026-10-21-night",
    "date": "2026-10-21",
    "slot": "night",
    "pillar": "SOCIAL_CONTRIBUTION",
    "text": "子育て中の夜がしんどいとき、ひとりで抱え込まなくていい。寄付先のプロジェクトは、子どもだけでなく親のつらさにも寄り添う活動をしています。",
    "threadsItemId": "lb-2026-10-21-night-ja",
    "requiresVerifiedFact": true,
