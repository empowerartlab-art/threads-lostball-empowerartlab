# Threads API (Meta) 用の環境変数テンプレート。
# 実際の値は .env.local に書き、絶対にコミットしない(.gitignoreで除外済み)。
# .env.local はこのスクリプト群が自動生成・更新する(scripts/exchange-threads-token.mjs)。

# Meta for Developers のアプリダッシュボードから取得する値
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_REDIRECT_URI=

# 認可フローで取得する一時的な値(使い捨て。交換後は不要)
THREADS_AUTH_CODE=

# scripts/exchange-threads-token.mjs が自動的に書き込む値(手動で入力する必要はない)
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_USERNAME=
THREADS_TOKEN_TYPE=
THREADS_TOKEN_EXPIRES_AT=
